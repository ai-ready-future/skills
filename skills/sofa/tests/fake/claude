#!/usr/bin/env bash
# Fake claude for the sofa tests. Writes its arguments, one per line, to
# $FAKE_CLAUDE_LOG, then prints the lines that the real `claude --bg` prints.
#
#   FAKE_CLAUDE_FAIL=1          prints an error and no session id
#   FAKE_CLAUDE_BACKGROUNDED=1  prints only the `backgrounded · <id> · <name>` line
printf '%s\n' "$@" > "${FAKE_CLAUDE_LOG:-/dev/null}"
name=''
while [ $# -gt 0 ]; do
  case "$1" in -n) name="${2:-}"; shift 2 ;; *) shift ;; esac
done
if [ "${FAKE_CLAUDE_FAIL:-0}" = "1" ]; then
  echo "error: something" >&2
  exit 1
fi
if [ "${FAKE_CLAUDE_BACKGROUNDED:-0}" = "1" ]; then
  echo "backgrounded · fake5678 · $name"
  exit 0
fi
echo "Started background session $name"
echo "  claude attach fake1234    open in this terminal"
echo "  claude logs fake1234      show the output"
exit 0
