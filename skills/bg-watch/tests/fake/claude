#!/usr/bin/env bash
# Fake claude for the bg-watch tests. Records each call in $CALLS.
# After the first agents call, it prints $FIXTURES/agents-later.json if that file exists.
# respawn exits $FAKE_RESPAWN_EXIT (default 0).
echo "claude $*" >> "$CALLS"
case "$1" in
  agents)
    if [ -f "$FIXTURES/agents-later.json" ] && [ "$(grep -c '^claude agents' "$CALLS")" -gt 1 ]; then
      cat "$FIXTURES/agents-later.json"
    else
      cat "$FIXTURES/agents.json"
    fi ;;
  logs) cat "$FIXTURES/logs/$2.txt" 2>/dev/null ;;
  respawn) [ "${FAKE_RESPAWN_EXIT:-0}" -eq 0 ] || { echo "cannot respawn $2" >&2; exit "$FAKE_RESPAWN_EXIT"; } ;;
esac
exit 0
